# ─────────────────────────────────────────────────────────────────────────────
#  Скопируй этот файл в .env и заполни. .env в .gitignore — не коммитится.
#  Все значения остаются на этой машине. Пустое значение = функция выключена
#  или работает значение по умолчанию.
# ─────────────────────────────────────────────────────────────────────────────

# ══ careered.io ══════════════════════════════════════════════════════════════
#
#  КАК ДОСТАТЬ ТОКЕН (2 минуты):
#   1. Открой https://careered.io в браузере, залогинься своим обычным аккаунтом.
#   2. F12 → вкладка Network (Сеть).
#   3. В поле фильтра набери:  /api/jobs
#   4. Обнови страницу (F5) — появится запрос вида  jobs?links_type=all&...
#   5. ПКМ по запросу → Copy → Copy as cURL (bash).
#   6. Из скопированного возьми:
#         -H 'authorization: ...'   → всё после "authorization: " в CAREERED_AUTH
#         -H 'user-agent: ...'      → в CAREERED_UA (должен совпадать с браузером)

# Заголовок Cookie целиком, одной строкой, как в cURL (нужен пробнику
# probe_careered.py; основной сбор ходит по CAREERED_AUTH).
CAREERED_COOKIE=
CAREERED_ACCESS_TOKEN=

# Заголовок Authorization целиком, включая слово Bearer, если оно есть.
CAREERED_AUTH=
CAREERED_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36

# Целевой фильтр вакансий.
CAREERED_QUERY=links_type=all&links=telegram&remote=true

# TLS: сертификат careered.io протух 2026-08-02. true = без проверки цепочки,
# НО с пиннингом SPKI (ниже). Вернуть в false, как только продлят сертификат.
CAREERED_INSECURE_TLS=true
# SHA-256 SPKI листового сертификата (base64). Пусто при первом запуске —
# пробник напечатает актуальный; дальше расхождение ловится как MITM.
CAREERED_SPKI_PIN=

# ══ Telegram (MTProto, ЛИЧНЫЙ аккаунт) ═══════════════════════════════════════
# https://my.telegram.org → API development tools → App api_id / api_hash.
# После заполнения: python tg_login.py  (разовый вход по коду из Telegram).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_PATH=jobhunter.session

# ══ Отбор и отправка ═════════════════════════════════════════════════════════
# Вакансии старше N дней не берём (закрытые позиции, мёртвые контакты).
MAX_VACANCY_AGE_DAYS=21
# Холодных сообщений в день (жёсткий потолок; тёплые ответы считаются отдельно).
DAILY_COLD_LIMIT=30
# Прикладывать резюме к первому сообщению.
SEND_CV_WITH_FIRST_MESSAGE=true
# Путь к «основному» резюме. Задан — рассылается именно этот файл,
# подгонка под вакансию не отправляется. Пусто — резюме собирается под роль.
BASE_CV_PATH=
# true = вся отправка печатается в лог, но никуда не уходит.
DRY_RUN=false
# Файл-стоп-кран: существует — вся отправка молчит. Также команда /stop в Избранном.
KILL_SWITCH_PATH=STOP_SENDING.flag

# ══ LLM (бесплатные тиры; без ключей работают шаблоны) ═══════════════════════
# Письма и черновики ответов проходят анти-фабрикация гейт независимо от модели.
LLM_ENABLED=true
LLM_CLASSIFY_ENABLED=true
LLM_REDACT_PII=true
# Оставь пустым для штатного fallback-порядка или укажи: groq,cerebras
LLM_PROVIDERS=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
# Модели менять не обязательно — дефолты рабочие.
#LLM_GEMINI_MODEL=gemini-2.5-flash
#LLM_GROQ_MODEL=llama-3.3-70b-versatile
#LLM_OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
#LLM_CEREBRAS_MODEL=llama-3.3-70b
#LLM_MISTRAL_MODEL=mistral-small-latest
#LLM_GITHUB_MODEL=openai/gpt-4o-mini

# ══ Следы работы бота ════════════════════════════════════════════════════════
# Отдельная папка-вкладка в Telegram со всеми диалогами, куда бот писал.
# «Избранное» при этом остаётся каналом управления и не забивается перепиской.
TG_FOLDER_ENABLED=true
TG_FOLDER_NAME=Работа
# Копия каждого отправленного сообщения на диск: logs/sent/ДАТА.md и .jsonl
SENT_ARCHIVE_ENABLED=true
#SENT_ARCHIVE_DIR=logs/sent
BOLD_AUTONOMY=false
APPLY_PREP_DAILY_LIMIT=25
ATS_DAILY_LIMIT=5

# ══ Переписка (входящие) ═════════════════════════════════════════════════════
# Автоответы только на рутину: «пришлите резюме», «когда созвон», «спасибо».
# Техвопросы/деньги/оффер/время интервью — всегда карточка владельцу.
AUTO_REPLY_ENABLED=true
EMAIL_AUTO_REPLY_ENABLED=true
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
IMAP_MAX_FETCH=200
EMAIL_REPLY_MIN_GAP_MIN=30
MAIL_BIND_SECRET=
INBOX_LOOKBACK_DAYS=45
INBOX_MAX_THREADS=120

# ══ Личный бот-пульт (BotFather) ═════════════════════════════════════════════
# Статистика, кнопки вместо команд, уведомления о событиях.
# Создать: @BotFather → /newbot → имя и username → токен сюда.
# После этого ОБЯЗАТЕЛЬНО нажать /start в своём боте: Telegram запрещает боту
# писать первым, пока пользователь сам не начал диалог.
TELEGRAM_BOT_TOKEN=
# Кому разрешено управлять. Свой id узнать: написать @userinfobot.
# ПУСТО = бот не выполняет ничего. Он управляет отправкой от твоего лица,
# поэтому открытым по умолчанию быть не может.
BOT_ALLOWED_USER_IDS=
# Куда уходят карточки на решение: bot | saved | both.
# saved — «Избранное» (работает без бота), bot — только бот,
# both — оба канала на время перехода (решение принимается один раз).
OWNER_CHANNEL=saved

# ══ Согласование с владельцем (Избранное) ════════════════════════════════════
# Команды в Saved Messages: /ok N, /time N 29.08 16:00, /no N, /send N,
# /say N текст, /skip N, /status, /stop, /go, /help.
OWNER_TZ=Europe/Moscow
OWNER_CONFIRM_REQUIRED=true
# Через сколько часов неотвеченная карточка считается протухшей.
OWNER_DECISION_TTL_HOURS=12

# ══ Интервью и Google Calendar ═══════════════════════════════════════════════
# Разовая настройка: Google Cloud Console → OAuth client (Desktop app) →
# скачать JSON → положить рядом как google_client_secret.json →
#   python -m jobhunter.schedule.gcal --login
INTERVIEW_DURATION_MIN=60
GCAL_ENABLED=true
GOOGLE_CLIENT_SECRET_PATH=google_client_secret.json
GOOGLE_TOKEN_PATH=google_token.json
GCAL_CALENDAR_ID=primary
# Создавать Google Meet и слать ссылку рекрутёру в подтверждении.
GCAL_CREATE_MEET=true

# ══ Автопоиск каналов с вакансиями ═══════════════════════════════════════════
DISCOVER_ENABLED=true
DISCOVER_MAX_CHECKS=60
DISCOVER_MIN_FRESH7=3
DISCOVER_MIN_CONTACTS=2

# ══ Email-отклики (Gmail: включи 2FA → App password) ═════════════════════════
SMTP_HOST=smtp.gmail.com
# 587 — STARTTLS; если соединение недоступно, 465 — TLS сразу при подключении.
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Suren Hakobyan
# Цель прогрева: старт 40/день, +5 за каждый день без отбивок.
EMAIL_DAILY_LIMIT=80

# ══ Прямые письма руководителям и рефералам ═══════════════════════════════════
# Адреса только опубликованные (сайт компании, публичный профиль GitHub), у каждого
# хранится ссылка-источник. Отправка автоматическая, но через гейты; две отбивки
# за день ставят канал на паузу. Включается владельцем.
DIRECT_ENABLED=false
DIRECT_DAILY_LIMIT=10
# Первые DIRECT_RAMPUP_DAYS дней — не больше DIRECT_RAMPUP_LIMIT писем.
DIRECT_RAMPUP_DAYS=2
DIRECT_RAMPUP_LIMIT=5
# Без токена GitHub даёт 60 запросов в час — хватает на 2–3 компании. Токен без
# прав (github.com → Settings → Developer settings → Fine-grained token, Public
# repositories read-only) поднимает лимит до 5000.
GITHUB_TOKEN=
# Brave Search API (https://brave.com/search/api, есть бесплатный тариф): страницы
# вне сайта компании, где опубликован адрес руководителя. Пусто — пропускается.
BRAVE_API_KEY=

# ══ Reddit hiring-посты (официальный Data API) ═══════════════════════════════
# Анонимный доступ Reddit закрыл. Создай приложение типа «script» на
# https://www.reddit.com/prefs/apps — id стоит под названием приложения,
# secret рядом. Пусто — источник пропускается.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ══ Пути (менять не обязательно) ═════════════════════════════════════════════
# При запуске в Docker эти пути переопределяются в docker-compose.yml:
# база и сессия уезжают в том, видимые файлы — в папку ./out.
#DB_PATH=jobhunter.db
#CV_OUT=cv_out
#OUT_DIR=.
#LOG_DIR=logs
#HEARTBEAT_DIR=logs
#PROFILE_PATH=profile.yaml
#LEXICON_PATH=lexicon/tech_terms.txt
#WEB_HOST=127.0.0.1
#WEB_PORT=8765
